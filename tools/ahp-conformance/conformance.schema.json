{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^wss?:\\/\\/"
        },
        "headers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "env"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "prompt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "query": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "env"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "prompt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "url",
        "headers",
        "query"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "default": ".",
          "type": "string"
        },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "readyTimeoutMs": {
          "default": 120000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "command",
        "cwd",
        "env",
        "readyTimeoutMs"
      ],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "tokens": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "token": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "env"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "prompt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "command"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "resource",
              "token"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tokens"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "catalogTimeoutMs": {
          "default": 30000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "catalogTimeoutMs"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "deterministic": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "deterministic"
      ],
      "additionalProperties": false
    },
    "quirks": {
      "type": "object",
      "properties": {
        "lazySessionInit": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "lazySessionInit"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "scratchDir": {
          "type": "string",
          "minLength": 1
        },
        "sharedFilesystem": {
          "default": true,
          "type": "boolean"
        },
        "keep": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "sharedFilesystem",
        "keep"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "concurrency": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "include": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "concurrency",
        "timeoutMs",
        "include",
        "exclude",
        "proposed"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "reporter": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "cli",
            "html"
          ]
        },
        "open": {
          "default": true,
          "type": "boolean"
        },
        "htmlFile": {
          "default": "ahp-conformance-report.html",
          "type": "string",
          "minLength": 1
        },
        "jsonFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reporter",
        "open",
        "htmlFile"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "target",
    "auth",
    "agent",
    "model",
    "quirks",
    "workspace",
    "run",
    "report"
  ],
  "additionalProperties": false
}
